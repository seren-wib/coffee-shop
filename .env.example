# Copy to .env and fill in the values. Never commit .env (SDD 9.1).
# Production sets DOTENV_PATH to a .env outside the release folder.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to backend/db.sqlite3 when empty.
SQLITE_PATH=
TOSS_SECRET_KEY=
# Defaults to orders.pg.TossPaymentsClient.
PAYMENTS_CLIENT=
LOG_LEVEL=INFO
# Toss Payments test client key, read only by spikes/toss-confirm-cancel (SDD 3.2).
TOSS_CLIENT_KEY=
